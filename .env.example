# ตัวแปรสภาพแวดล้อมทั้งหมดขึ้นต้นด้วย GACP_ และประกาศ schema ไว้ที่ packages/contracts/src/env.ts
# คัดลอกไฟล์นี้เป็น .env.local (ไม่เข้า git) แล้วเติมค่าจริง

# development | test | demo | staging | production
GACP_ENV=development

# ฐานข้อมูลบนเครื่อง (embedded-postgres จาก `pnpm db:dev`) ค่าเริ่มต้นตรงกับสคริปต์
GACP_DATABASE_URL=postgresql://gacp:gacp@127.0.0.1:54329/gacp
GACP_DATABASE_DIRECT_URL=postgresql://gacp:gacp@127.0.0.1:54329/gacp

# Supabase demo (สลับมาใช้เมื่อต้องต่อฐาน demo) ใส่รหัสผ่านฐานข้อมูลแทน [YOUR-PASSWORD] ในไฟล์นี้เท่านั้น ห้ามส่งรหัสผ่านทางแชท
# GACP_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.spbdkellhyndyexljuar.supabase.co:5432/postgres
# GACP_DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.spbdkellhyndyexljuar.supabase.co:5432/postgres
# Supabase staging
# GACP_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lqmvduxipfjygeitwufe.supabase.co:5432/postgres
# GACP_DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lqmvduxipfjygeitwufe.supabase.co:5432/postgres

# กุญแจเข้ารหัส session cookie (สุ่ม 64 ตัวอักษรฐานสิบหก)
GACP_SESSION_SECRET=replace-with-64-hex-characters

# เปิดหน้า login แบบ dev (เลือกบทบาทได้) ได้เฉพาะ development/test เท่านั้น ระบบปฏิเสธการบูตถ้าเปิดใน production
GACP_AUTH_DEV_LOGIN_ENABLED=true

# ThaID (DOPA) กรอกเมื่อได้รับ credentials
# GACP_THAID_ISSUER_URL=
# GACP_THAID_CLIENT_ID=
# GACP_THAID_CLIENT_SECRET=

# Stripe (test mode จนกว่า operator สั่ง live)
# GACP_STRIPE_SECRET_KEY=
# GACP_STRIPE_WEBHOOK_SECRET=
