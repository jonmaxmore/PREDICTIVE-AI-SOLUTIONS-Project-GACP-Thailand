# ตัวแปรสภาพแวดล้อมทั้งหมดขึ้นต้นด้วย GACP_ และประกาศ schema ไว้ที่ packages/contracts/src/env.ts
# คัดลอกไฟล์นี้เป็น .env.local (ไม่เข้า git) แล้วเติมค่าจริง

# development | test | demo | staging | production
GACP_ENV=development

# ฐานข้อมูลบนเครื่อง (embedded-postgres จาก `pnpm db:dev`) ค่าเริ่มต้นตรงกับสคริปต์
GACP_DATABASE_URL=postgresql://gacp:gacp@127.0.0.1:54329/gacp
GACP_DATABASE_DIRECT_URL=postgresql://gacp:gacp@127.0.0.1:54329/gacp

# Supabase demo (สลับมาใช้เมื่อต้องต่อฐาน demo) ใส่รหัสผ่านฐานข้อมูลแทน [YOUR-PASSWORD] ในไฟล์นี้เท่านั้น ห้ามส่งรหัสผ่านทางแชท
# GACP_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.spbdkellhyndyexljuar.supabase.co:5432/postgres
# GACP_DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.spbdkellhyndyexljuar.supabase.co:5432/postgres
# Supabase staging
# GACP_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lqmvduxipfjygeitwufe.supabase.co:5432/postgres
# GACP_DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lqmvduxipfjygeitwufe.supabase.co:5432/postgres

# กุญแจเข้ารหัส session cookie (สุ่ม 64 ตัวอักษรฐานสิบหก)
GACP_SESSION_SECRET=replace-with-64-hex-characters

# กุญแจเข้ารหัสและ HMAC ข้อมูลส่วนบุคคลที่อ่อนไหว (เลขบัตรประชาชน subject ของผู้ให้บริการยืนยันตัวตน)
# สร้างด้วย: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"  คนละค่า ห้ามใช้ซ้ำข้าม environment
GACP_DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
GACP_DATA_HMAC_KEY=replace-with-64-hex-characters

# ที่เก็บไฟล์เอกสาร: local (dev/test เก็บใน .storage) หรือ s3 (Supabase Storage bucket ส่วนตัว ผ่าน S3 protocol)
GACP_STORAGE_DRIVER=local
GACP_STORAGE_LOCAL_DIR=.storage
# GACP_STORAGE_DRIVER=s3
# GACP_STORAGE_S3_ENDPOINT=https://spbdkellhyndyexljuar.supabase.co/storage/v1/s3
# GACP_STORAGE_S3_REGION=ap-southeast-1
# GACP_STORAGE_S3_BUCKET=gacp-documents
# GACP_STORAGE_S3_ACCESS_KEY_ID=
# GACP_STORAGE_S3_SECRET_ACCESS_KEY=

# เปิดหน้า login แบบ dev (เลือกบทบาทได้) ได้เฉพาะ development/test เท่านั้น ระบบปฏิเสธการบูตถ้าเปิดใน production
GACP_AUTH_DEV_LOGIN_ENABLED=true

# ผู้ให้บริการยืนยันตัวตน (ADR 0004): บังคับครบทั้ง 10 ตัวเมื่อ GACP_ENV เป็น demo/staging/production
# ระหว่างยังไม่มี client จริง ปุ่มเข้าสู่ระบบด้วย Health ID / ThaID จะปิด และใช้ dev login แทน (development/test เท่านั้น)
# URL สาธารณะของแอป ใช้ประกอบ redirect_uri ที่ลงทะเบียนกับหน่วยงาน (เช่น https://dev.demo.gacpth.com)
# GACP_PUBLIC_BASE_URL=

# ThaID ของกรมการปกครอง (OpenID Connect) ขอ client จาก DOPA พร้อมแจ้ง redirect_uri <BASE_URL>/auth/thaid/callback
# sandbox: https://imauthsbx.bora.dopa.go.th  production: https://imauth.bora.dopa.go.th
# GACP_THAID_ISSUER_URL=https://imauthsbx.bora.dopa.go.th
# GACP_THAID_CLIENT_ID=
# GACP_THAID_CLIENT_SECRET=

# Health ID ของหมอพร้อม (OAuth2) ขอ client จากสำนักสุขภาพดิจิทัล พร้อมแจ้ง redirect_uri <BASE_URL>/auth/morphrom/callback
# UAT: https://uat-moph.id.th  production: https://moph.id.th
# GACP_MORPHROM_HEALTH_ID_BASE_URL=https://uat-moph.id.th
# GACP_MORPHROM_HEALTH_ID_CLIENT_ID=
# GACP_MORPHROM_HEALTH_ID_CLIENT_SECRET=

# Provider ID (เครดิตเจ้าหน้าที่) ใช้ client ของระบบเรากับ token ของ Health ID
# UAT: https://uat-provider.id.th  production: https://provider.id.th
# GACP_MORPHROM_PROVIDER_ID_BASE_URL=https://uat-provider.id.th
# GACP_MORPHROM_PROVIDER_ID_CLIENT_ID=
# GACP_MORPHROM_PROVIDER_ID_SECRET_KEY=

# Stripe (test mode จนกว่า operator สั่ง live)
# GACP_STRIPE_SECRET_KEY=
# GACP_STRIPE_WEBHOOK_SECRET=
