# ============================================================
# .env.preview — template for the hidden preview.gacpth.com stack
# ============================================================
# Copy to /opt/gacp-platform/.env.preview ON THE BOX and fill in real values.
# The real file is gitignored (.gitignore `.env.*`); only this .example is
# tracked. NOTHING in this file may ever contain a real secret.
#
#   cp .env.preview.example /opt/gacp-platform/.env.preview
#   chmod 600 /opt/gacp-platform/.env.preview
#   chown root:root /opt/gacp-platform/.env.preview
#
# This one file is read TWICE, by two different mechanisms:
#   - `docker compose --env-file .env.preview …` resolves ${...} inside
#     docker-compose.preview.yml (image tag, public URL)
#   - `env_file:` on backend-preview injects it into that container
# Values used only by the first mechanism (PREVIEW_IMAGE_TAG) also end up in
# the backend container's environment. Harmless, and worth knowing.

# ── image selection ──────────────────────────────────────────
# Written by scripts/deploy/deploy-preview.sh as local-<first 12 of the SHA>;
# set it by hand only to pin an older build. No default: compose fails loudly
# rather than starting yesterday's image.
PREVIEW_IMAGE_TAG=local-000000000000
# Override only to test an image from another repository/registry.
PREVIEW_BACKEND_IMAGE=ghcr.io/jonmaxmore/gacp-backend
PREVIEW_FRONTEND_IMAGE=ghcr.io/jonmaxmore/gacp-frontend

# ── public identity ──────────────────────────────────────────
# Drives CORS_ORIGIN / FRONTEND_URL / APP_URL / trace URLs in one place.
PREVIEW_PUBLIC_URL=https://preview.gacpth.com
# Session-cookie scope. Host-bound on purpose so a preview session can never be
# replayed against staging or production.
PREVIEW_COOKIE_DOMAIN=preview.gacpth.com
# x-forwarded-host allowlist for the QR/verify origin. Setting it REPLACES the
# built-in list, so every host that must keep working is named.
PREVIEW_VERIFY_HOST_ALLOWLIST=gacpth.com,staging.gacpth.com,preview.gacpth.com

# ── data stores ──────────────────────────────────────────────
# THE Supabase dev database that laptop testing already uses — copy this line
# verbatim from the laptop's root .env so both point at one dataset.
DATABASE_URL=postgresql://USER:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=public
# The box's existing gacp-redis container, reached over the shared
# gacp-network. Index 2 keeps preview off prod (0) and staging (1).
REDIS_URL=redis://:REDIS_PASSWORD_HERE@redis:6379/2

# ── secrets the backend needs at runtime ─────────────────────
# Signs health-role JWTs. Any value >= 32 chars; do NOT reuse production's.
HEALTH_JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM
# Signs provider/DTAM-role JWTs. Same rule.
PROVIDER_JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM
# Keys PDPA field encryption and the *Hmac lookup columns. MUST be identical to
# the value the laptop uses against this same Supabase DB, or rows written from
# one side read back as [PII_DECRYPT_FAILED] on the other.
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM
# Fallback secret for QR signatures when the RSA key is unavailable.
QR_SIGNATURE_FALLBACK_SECRET=CHANGE_ME
# services/crypto/signature-service.js refuses to boot when this is unset.
RSA_PRIVATE_KEY_PASSPHRASE=CHANGE_ME
# Verifies inbound payment-webhook signatures. Preview takes no live payments;
# a distinct throwaway value is correct here.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
# Express session signing key.
SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM
# Keyed HMAC for national-ID lookup columns. Match the laptop for the same
# reason as ENCRYPTION_KEY.
HMAC_KEY=CHANGE_ME
# Envelope key for at-rest field encryption. Match the laptop.
MASTER_ENCRYPTION_KEY=CHANGE_ME

# ── optional / leave empty unless the matching feature is wanted ──
# Cheaper password hashing for a demo box. 10 is what staging uses.
BCRYPT_ROUNDS=10
# Enables the mutating /api/v1/e2e/* routes. Empty = fail-closed (correct
# default; only set it while running the e2e suite against preview).
E2E_SECRET=
# Audit hash-chain keying. Empty keeps the v2 chain, which is what the shared
# dev DB already contains. Set only in step with the laptop.
AUDIT_HASH_HMAC=
AUDIT_HASH_KEY=
# Verify the audit chain only from this sequence number forward.
AUDIT_CHAIN_VERIFY_FROM_SEQ=0
# PDPA rollout flags. Keep these EQUAL to the laptop's values — they change how
# rows in the shared database are written and read.
AUTH_LOOKUP_USE_HMAC=false
APP_FK_USE_TOKEN=false
ENABLE_PDPA_FIELD_ENCRYPTION=false
# Per-partner M2M keys for /api/interoperability/v1/*. Empty = fail-closed.
INTEROP_PARTNER_API_KEYS=
# Shown on payment pages and financial documents. Empty renders the
# "pending finance confirmation" state instead of a wrong account number.
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NO=
PLATFORM_PROMPTPAY_ID=
