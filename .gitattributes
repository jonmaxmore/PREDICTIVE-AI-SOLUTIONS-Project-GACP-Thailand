# Default: text files use LF on commit
* text=auto eol=lf

# Shell scripts: enforce LF + executable bit on all platforms
*.sh text eol=lf
*.sh executable

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.pdf binary

# Vendored fonts (self-hosted Sarabun for the PDF pipeline and the mobile app)
# and OCR language models. Marked explicitly so an eol=lf/CRLF filter can never
# rewrite a byte inside them — a silently corrupted font or traineddata file is
# very hard to diagnose.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.traineddata binary
