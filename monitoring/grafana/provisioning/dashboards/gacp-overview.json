{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "CPU Usage per Container",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "rate(container_cpu_usage_seconds_total{name=~\"gacp-.*\"}[5m]) * 100",
                    "legendFormat": "{{name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "custom": {
                        "fillOpacity": 20,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "Memory Usage per Container",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "container_memory_usage_bytes{name=~\"gacp-.*\"} / 1024 / 1024",
                    "legendFormat": "{{name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "decmbytes",
                    "custom": {
                        "fillOpacity": 20,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "Network I/O per Container",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(container_network_receive_bytes_total{name=~\"gacp-.*\"}[5m])",
                    "legendFormat": "{{name}} RX"
                },
                {
                    "expr": "rate(container_network_transmit_bytes_total{name=~\"gacp-.*\"}[5m])",
                    "legendFormat": "{{name}} TX"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "Disk I/O per Container",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(container_fs_reads_bytes_total{name=~\"gacp-.*\"}[5m])",
                    "legendFormat": "{{name}} Read"
                },
                {
                    "expr": "rate(container_fs_writes_bytes_total{name=~\"gacp-.*\"}[5m])",
                    "legendFormat": "{{name}} Write"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "Host - CPU Usage",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 60
                            },
                            {
                                "color": "red",
                                "value": 85
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Host - Memory Usage",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 6,
                "y": 16
            },
            "targets": [
                {
                    "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 70
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Host - Disk Usage",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 12,
                "y": 16
            },
            "targets": [
                {
                    "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 70
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Host - Uptime",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 18,
                "y": 16
            },
            "targets": [
                {
                    "expr": "time() - node_boot_time_seconds"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            }
        },
        {
            "title": "Container Restart Count",
            "type": "table",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 12,
                "x": 0,
                "y": 22
            },
            "targets": [
                {
                    "expr": "container_start_time_seconds{name=~\"gacp-.*\"}",
                    "legendFormat": "{{name}}",
                    "format": "table",
                    "instant": true
                }
            ]
        },
        {
            "title": "Host - Network Traffic",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 6,
                "w": 12,
                "x": 12,
                "y": 22
            },
            "targets": [
                {
                    "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
                    "legendFormat": "{{device}} RX"
                },
                {
                    "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
                    "legendFormat": "{{device}} TX"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "custom": {
                        "fillOpacity": 15,
                        "lineWidth": 2
                    }
                }
            }
        }
    ],
    "schemaVersion": 39,
    "tags": [
        "gacp",
        "docker",
        "production"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "Asia/Bangkok",
    "title": "GACP Platform - Production Overview",
    "uid": "gacp-production-overview",
