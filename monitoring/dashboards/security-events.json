      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "rate(admin_force_status_total[5m])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rate Limit Hits (429s)",
      "datasource": "Prometheus",
      "description": "Requests blocked by express-rate-limit middleware",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "rate(rate_limit_hit_total[1m])",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
