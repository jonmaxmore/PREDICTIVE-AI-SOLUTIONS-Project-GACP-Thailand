    {
      "id": 6,
      "type": "table",
      "title": "Top Source IPs by Failed Auth",
      "datasource": "Prometheus",
      "description": "Top-10 IPs producing failed logins in last 1h",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "topk(10, sum by (source_ip) (increase(auth_login_failed_total[1h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
