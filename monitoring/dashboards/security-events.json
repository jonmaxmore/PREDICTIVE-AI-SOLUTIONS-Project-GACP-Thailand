      "title": "Failed Auth Attempts (per minute)",
      "datasource": "Prometheus",
      "description": "Login attempts that returned 401/403. Spike => possible brute force.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "rate(auth_login_failed_total[1m])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JWT Verification Failures",
      "datasource": "Prometheus",
      "description": "Invalid signature / expired / malformed JWTs rejected by middleware",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "rate(jwt_verification_failed_total[1m])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PDPA Erasure Requests (last 30d)",
      "datasource": "Prometheus",
      "description": "Right-to-erasure requests filed under PDPA Section 33. Iter 27 territory.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        {
          "expr": "increase(pdpa_erasure_requests_total[30d])",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Admin Force-Status Overrides",
      "datasource": "Prometheus",
