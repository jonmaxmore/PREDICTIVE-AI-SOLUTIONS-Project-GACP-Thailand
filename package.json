{
  "name": "gacp-platform",
  "version": "3.8.0",
  "private": true,
  "description": "GACP Platform - Backend API + Flutter Mobile App",
  "scripts": {
    "build": "npm --prefix apps/backend run build && npm --prefix apps/web-app run build",
    "install:ci": "npm --prefix apps/backend ci && npm --prefix apps/web-app ci --legacy-peer-deps",
    "security:audit:backend": "npm --prefix apps/backend audit --audit-level=high",
    "gate:member-auth-lint": "npm --prefix apps/web-app run lint:auth",
    "gate:trust-interoperability-lint": "npm --prefix apps/web-app run lint:trust",
    "verify:build": "npm run install:ci && npm run build && npm run check:no-new-eslint-warnings && npm run check:encoding && npm run gate:member-auth-lint && npm run gate:trust-interoperability-lint && npm run security:audit:backend",
    "setup:local": "node apps/backend/scripts/bootstrap-dev.js",
    "doctor": "node scripts/system-integrity-check.js",
    "dev": "cd apps/backend && cross-env PORT=8000 node server.js",
    "start": "cd apps/backend && cross-env PORT=8000 node server.js",
    "test": "cd apps/backend && node node_modules/jest/bin/jest.js --config jest.config.cjs --forceExit",
    "lint": "cd apps/backend && npx eslint .",
    "check:orphan-routes": "node scripts/ci/check-orphan-api-routes.js",
    "check:provider-api-surface": "node scripts/ci/check-frontend-provider-api-usage.js",
    "check:repo-naming": "node scripts/ci/check-repo-naming.js",
    "check:banned-terms": "node scripts/ci/check-banned-terms.js",
    "check:green-mask": "node scripts/ci/check-green-mask-assertions.js",
    "check:security-conventions": "node scripts/ci/check-security-conventions.js",
    "check:tenant-conventions": "node scripts/ci/check-tenant-conventions.js",
    "check:production-topology": "node scripts/ci/check-production-topology.js",
    "check:access-allowlist": "node scripts/ci/check-access-allowlist.js",
    "check:infra-contracts": "node scripts/ci/check-infra-contracts.js",
    "score:provider-evaluation": "node scripts/tools/summarize-provider-evaluation.js docs/deployment/provider-evaluation-scorecard.csv",
    "check:prisma-migration-consistency": "node scripts/ci/check-prisma-migration-consistency.js",
    "check:ux-ui-baseline": "node scripts/ci/check-ui-a11y-baseline.js",
    "check:no-new-eslint-warnings": "node scripts/ci/check-no-new-eslint-warnings.js",
    "check:max-lines": "node scripts/ci/check-max-lines.js --mode=delta --warn=500",
    "check:ai-style": "node scripts/ci/check-ai-style-smells.js",
    "check:closing-patterns": "node scripts/ci/check-closing-patterns.js",
    "check:hardcoded-tax-ids": "node scripts/ci/check-hardcoded-tax-ids.js",
    "check:encoding": "node scripts/ci/check-mojibake-encoding.js",
    "check:jest-module-mode": "node scripts/ci/check-webapp-jest-module-mode.js",
    "fix:encoding": "node scripts/tools/fix-mojibake-encoding.js --write",
    "audit:vnext": "node scripts/tools/vnext-audit.js",
    "gate:bi-contract": "cd apps/backend && npm test -- --runTestsByPath __tests__/integration/reports.test.js",
    "gate:auth-hardening": "node scripts/test/run-auth-hardening-gate.js",
    "typecheck:web": "cd apps/web-app && npx tsc -p tsconfig.json --noEmit",
    "test:auth-readiness": "node scripts/ci/check-health-login-readiness.js",
    "test:journey:bad": "node scripts/test/run-member-bad-journey-check.js",
    "test:journey:chaos": "node scripts/test/run-chaos-journey-check.js",
    "test:journey:full": "node scripts/test/run-full-journey-suite.js",
    "test:smoke": "cd apps/web-app && npx playwright test e2e/smoke.spec.ts --project=chromium",
    "test:smoke:api": "cd apps/backend && npx jest --config jest.config.cjs --testPathPatterns smoke-all-endpoints",
    "test:e2e": "cd apps/web-app && npx playwright test e2e/e2e-*.spec.ts --project=chromium",
    "test:e2e:health": "cd apps/web-app && npx playwright test e2e/e2e-health-portal.spec.ts --project=chromium",
    "test:e2e:provider": "cd apps/web-app && npx playwright test e2e/e2e-provider-portal.spec.ts --project=chromium",
    "test:e2e:scheduler": "cd apps/web-app && npx playwright test e2e/e2e-provider-scheduler.spec.ts --project=chromium",
    "test:e2e:reviewer": "cd apps/web-app && npx playwright test e2e/e2e-provider-reviewer.spec.ts --project=chromium",
    "test:e2e:account": "cd apps/web-app && npx playwright test e2e/e2e-provider-account.spec.ts --project=chromium",
    "test:e2e:admin": "cd apps/web-app && npx playwright test e2e/e2e-admin-portal.spec.ts --project=chromium",
    "test:e2e:trace": "cd apps/web-app && npx playwright test e2e/e2e-trace.spec.ts --project=chromium",
    "test:e2e:golden": "cd apps/web-app && npx playwright test e2e/e2e-golden-scenario.spec.ts --project=chromium",
    "test:uat": "cd apps/web-app && npx playwright test e2e/uat-business-rules.spec.ts --project=chromium",
    "test:all": "npm run test:smoke:api && npm run test:smoke && npm run test:e2e && npm run test:uat",
    "format": "npx prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "prepare": "husky",
    "check:identity-fields": "node scripts/ci/check-identity-field-usage.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.6",
    "pm2": "^6.0.13",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "publicHoistPattern": [
      "eslint-*",
      "@typescript-eslint/*",
      "@eslint/*"
    ],
    "overrides": {
      "postcss": ">=8.5.23 <9",
      "rollup": "^4.0.0",
      "lodash": "^4.18.1",
      "qs": ">=6.15.2 <7",
      "validator": "13.15.26",
      "basic-ftp": "^6.2.1",
      "handlebars": "^4.7.9",
      "systeminformation": "^5.31.7",
      "picomatch": "^4.0.4",
      "flatted": "^3.4.2",
      "fast-xml-parser": "^5.5.6",
      "fast-xml-builder": "^1.1.7",
      "path-to-regexp": "^0.1.13",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "ws": "^7.5.11",
      "form-data": "^4.0.6",
      "sharp": "^0.35.4",
      "next": "^15.5.26",
      "typescript": "^5.9.3",
      "recharts>react-is": "18.3.1",
      "axios": "^1.20.0",
      "fast-uri": "^3.1.4",
      "brace-expansion@<1.1.16": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.7",
      "js-yaml@<3.15.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@2": ">=2.1.7 <3",
      "body-parser": ">=1.20.6 <2",
      "morgan": ">=1.11.0 <2",
      "ip-address": ">=10.3.1 <11",
      "uuid": ">=11.1.1 <12",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "browserslist@<4.28.7": "^4.28.7"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-14257"
      ]
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "*.js": "npx eslint --fix",
    "*.{json,md,yml,yaml}": "npx prettier --write"
  }
}
