# ============================================================
# GACP Platform — Nginx Blue/Green Upstream Template
# ============================================================
# Generated by scripts/deploy/deploy-bluegreen.sh from this template.
# DO NOT edit the generated file at /etc/nginx/conf.d/bluegreen-upstream.conf
# directly — re-run the deploy script with the desired ACTIVE_COLOR.
#
# The {{ACTIVE_COLOR}} placeholder is replaced with `blue` or `green`
# at deploy time:
#
#   sed "s/{{ACTIVE_COLOR}}/$NEW_COLOR/g" \
#       nginx/bluegreen-upstream.conf.template \
#       > /etc/nginx/conf.d/bluegreen-upstream.conf
#   nginx -t && systemctl reload nginx
#
# After reload, ALL traffic instantly routes to the new color. The old
# color stays running for the grace period (default 60 s) so any in-flight
# requests can finish, then the deploy script stops it.

upstream gacp_backend_active {
    # Both colors are present in the docker network; this upstream points
    # at whichever one is currently active.
    server gacp-backend-{{ACTIVE_COLOR}}:8000 max_fails=3 fail_timeout=10s;

    # Keep the OTHER color as a backup so connections drain smoothly if
    # the just-promoted color crashes during the cutover window.
    server gacp-backend-{{INACTIVE_COLOR}}:8000 backup max_fails=3 fail_timeout=10s;

    keepalive 64;
}

upstream gacp_frontend_active {
    server gacp-frontend-{{ACTIVE_COLOR}}:3000 max_fails=3 fail_timeout=10s;
    server gacp-frontend-{{INACTIVE_COLOR}}:3000 backup max_fails=3 fail_timeout=10s;
    keepalive 64;
}

# Diagnostic — lets the deploy script confirm which color the running nginx
# is routing to. Returns the active color as plain text on /__bluegreen.
server {
    listen 127.0.0.1:8081;          # bound only to loopback — internal only
    server_name _;
    location = /__bluegreen {
        access_log off;
        return 200 "{{ACTIVE_COLOR}}\n";
        add_header Content-Type text/plain;
    }
}
