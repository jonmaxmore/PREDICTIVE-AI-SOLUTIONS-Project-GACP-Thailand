# apps/web-app/.env.example — the frontend's OWN environment, tracked.
#
# Copy to .env.local for a laptop. Every NEXT_PUBLIC_* value is baked into the browser bundle
# at build time and is therefore public by definition; nothing secret belongs here.
#
# WHY THIS FILE EXISTS
#   Until 2026-08-27 the web app had no env template at all, and the one flag below lived
#   only in the environment of a dev-server process that happened to have been started with
#   it. When that process was restarted on a newer tree, the flag vanished and the farmer's
#   payments screen rendered NOTHING — no amount, no button, no message (ledger UX-9, reproduced
#   live in the G4 walk: the walk sat 60 s waiting for a pay button the product was not going
#   to draw). A setting that a farmer's ability to pay depends on cannot live in a process's
#   memory; it lives in a tracked file with its reason beside it.

# ── payments ────────────────────────────────────────────────────────────────
# Shows the Stripe checkout door on /health/payments and lets /health/payments/checkout
# render. Read by src/lib/config/checkout-mode.ts, FAIL-CLOSED: only the exact string
# "true" enables it (not "1", not "TRUE"). Unset or anything else → the checkout page 404s
# and the payments screen draws no pay button.
#
# With payment slips being retired, checkout is the ONLY way a farmer can pay, so this flag
# being off is a silent outage of the money path. Set it everywhere the app runs.
NEXT_PUBLIC_CHECKOUT_UI_ENABLED=true

# Which checkout service the UI talks to (src/lib/config/checkout-mode.ts getCheckoutApiMode):
# exactly "mock" → the in-browser mock; ANY other value, or unset → "live" (the real backend
# and Stripe). Leave it unset for a laptop walk against the real stack.
# NEXT_PUBLIC_CHECKOUT_API_MODE=

# ── backend, as the BROWSER sees it ─────────────────────────────────────────
# Browser → Next.js → backend, through the proxy route app/api/[...path]/route.ts. So this
# is the site's OWN origin (scheme + host + port, NO /api suffix — adding /api sends every
# call to the wrong path; deploy-preview.sh:174 learned that), and the default is the
# frontend itself. Read by next.config.ts:14 and re-exported into the bundle at :47; also a
# Dockerfile ARG (:39) that deploy-preview.sh passes as the preview URL.
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Origin the ThaID / IdP client talks to (src/lib/api/idp-client.ts). Has a built-in
# default; set only when the backend is somewhere the code does not expect.
# NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000

# ── backend, as the SERVER sees it (not public, not in the bundle) ──────────
# Where Next.js itself reaches the backend for the /uploads rewrite (next.config.ts:8).
# Priority: INTERNAL_API_URL → BACKEND_URL → http://localhost:8000. Inside docker this is
# the service name, not localhost.
# INTERNAL_API_URL=http://localhost:8000

# ── PWA ─────────────────────────────────────────────────────────────────────
# Off until TLS and the domain are fully trusted in production (next.config.ts). Dockerfile
# ARG default false.
NEXT_PUBLIC_PWA_ENABLED=false

# ── error tracking (Sentry) ────────────────────────────────────────────────
# Re-added 2026-10-02 by operator decision, with personal-data scrubbing
# (packages/error-reporting/src/scrub.js, shared with the backend). OFF while the DSN is
# empty: the SDK chunk is never requested and nothing is sent. Read only by
# src/lib/config/sentry.ts. Runbook: docs/operations/sentry-error-tracking.md
#
# BUILD-TIME: `next build` inlines these into the bundle, so for an image they are
# Dockerfile ARGs (--build-arg), not container env. A DSN is an ingest-only key and public
# by design, but a real one still never goes in this tracked file.
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Empty → the page's hostname (one image serves demo and staging).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# The browser's release: in an image the Dockerfile sets it from the GIT_SHA build arg
# (same value the server reports). Set it here only for a local build.
# NEXT_PUBLIC_SENTRY_RELEASE=
# Optional. 0..1; empty → 0.05.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
#
# RUNTIME, server side only (set per container in compose; never in the bundle):
# SENTRY_ENVIRONMENT=staging
