# GACP Backend - Production Dockerfile (Multi-Stage)
# Build from Root Context (Monorepo Standard)

# ===========================================
# Stage 1: Builder
# ===========================================
FROM node:24-alpine AS builder

# Install system dependencies (openssl is critical for Prisma).
# Pin pnpm to the same major version as packageManager in root
# package.json (`pnpm@8.15.0`). The lockfile was generated by pnpm 8;
# installing the latest pnpm (currently 10.x) at build time causes
# `--frozen-lockfile` to fail with format incompatibility. The web-app
# Dockerfile that builds successfully also pins pnpm — backend now
# matches.
RUN apk add --no-cache openssl && npm install -g pnpm@8

# Create app directory
WORKDIR /app

# Copy root configurations (for hoisting pnpm workspace)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy shared packages (workspace dependencies)
COPY packages ./packages

# Copy Backend Code
COPY apps/backend ./apps/backend

# Install only backend + its workspace dependencies (not frontend/web-app)
RUN pnpm install --frozen-lockfile --ignore-scripts --filter=gacp-backend...

# Generate Prisma Client (inside backend folder)
WORKDIR /app/apps/backend
# Data sovereignty (PDPA): the Prisma CLI otherwise phones home to
# checkpoint.prisma.io (US) on every `generate`, reporting CLI/Node/OS
# versions and an anonymous install id. No PII is involved, but this
# platform makes no outbound calls it does not need, so the check is
# disabled at build time.
ENV CHECKPOINT_DISABLE=1
# `prisma generate` does NOT connect to the database — it just reads
# DATABASE_URL to know the connector type and generates the matching
# client code. So passing a syntactically-valid placeholder URL is
# enough; the real DATABASE_URL comes from the runtime env (docker
# compose / .env.production) when the container starts.
#
# Earlier this step `sed -i ... .env` to rewrite localhost → docker
# service names. That depended on `apps/backend/.env` existing in the
# build context, which it does NOT in CI (gitignored). The build was
# silently failing on `sed: .env: No such file or directory`, which
# is why ghcr.io/jonmaxmore/gacp-backend hadn't been republished
# while gacp-frontend kept being updated.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build_placeholder" \
    npx prisma generate --schema=prisma/schema

# ===========================================
# Stage 2: Production Runner
# ===========================================
FROM node:24-alpine AS runner

# Install runtime dependencies:
#   - openssl + libc6-compat: Prisma on Alpine
#   - curl: healthcheck
#   - chromium + nss + freetype + harfbuzz + ca-certificates + ttf-freefont:
#     puppeteer needs a browser binary for invoice / receipt PDF rendering.
#     We use the system chromium (smaller + reproducible) and point
#     puppeteer at it via PUPPETEER_EXECUTABLE_PATH below — which also
#     makes PUPPETEER_SKIP_DOWNLOAD=true safe (the post-install Chrome
#     download is not invoked here anyway because pnpm install runs with
#     --ignore-scripts in the builder stage).
RUN apk add --no-cache \
    curl \
    openssl \
    libc6-compat \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Security: Run as non-root user
RUN addgroup -g 1001 nodejs && \
  adduser -u 1001 -G nodejs -D gacp

WORKDIR /app

# Copy pruned node_modules from builder (production deps only)
COPY --from=builder --chown=gacp:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=gacp:nodejs /app/package.json ./package.json
COPY --from=builder --chown=gacp:nodejs /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# The workspace packages themselves. pnpm links a workspace dependency as a
# SYMLINK — `apps/backend/node_modules/@gacp/validation -> ../../../../packages/validation`
# — so copying node_modules without this line ships a dangling link, and every
# `require('@gacp/validation/...')` dies at boot with MODULE_NOT_FOUND.
#
# It stayed invisible because nothing on the boot path imported the package: the
# image built clean, started clean, and only broke when a0fe46b8 (2026-08-27) put
# `@gacp/validation/thai-id-checksum` behind server.js -> prisma-database ->
# prisma-pdpa-extension -> formdata-pii -> thai-id-validator. From that commit the
# backend could not boot in Docker at all, and no one saw it because no image was
# built between then and 2026-09-05. `@gacp/validation/satisfaction-families` (the
# B1 requirement lens) and `./upload-rules` are on the same footing.
#
# 96 KB, and it is the source of truth the browser wizard shares — never a copy.
COPY --from=builder --chown=gacp:nodejs /app/packages ./packages

# Copy backend application code + generated Prisma client
COPY --from=builder --chown=gacp:nodejs /app/apps/backend ./apps/backend

# Create necessary directories owned by non-root user.
# `keys` holds the signature-service RSA key pair and is bind-mounted to the
# gacp_signing_keys volume in production. Create + chown it here so a freshly
# created (empty) volume inherits gacp:nodejs ownership on first mount —
# otherwise the volume comes up root-owned and the uid-1001 container hits
# EACCES writing keys/public.pem and crash-loops on boot (signature-service).
WORKDIR /app/apps/backend
RUN mkdir -p uploads logs certificates keys && chown -R gacp:nodejs uploads logs certificates keys

# Set environment
ENV NODE_ENV=production
ENV PORT=8000

# Build identity, read back out by GET /api/health via shared/build-info.js.
#
# LAST of the ENV lines on purpose: these two change on every commit, and every
# layer below an invalidated one rebuilds. Everything expensive — pnpm install,
# prisma generate, the apk layer — is already above, so putting them here costs
# one cheap layer per build instead of a full rebuild. A slow build is a build
# people route around, and routing around the build is how staging ended up
# three weeks stale in the first place.
#
# Left unset they expand to "", which build-info.js normalises to null. That is
# deliberate: an image that cannot say which commit it is must say so, rather
# than answer with a placeholder that reads as a different commit.
ARG GIT_SHA=""
ARG BUILT_AT=""
ENV GIT_SHA=${GIT_SHA}
ENV BUILT_AT=${BUILT_AT}

# Switch to non-root user
USER gacp

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/api/health || exit 1

# Start application
CMD ["node", "server.js"]
