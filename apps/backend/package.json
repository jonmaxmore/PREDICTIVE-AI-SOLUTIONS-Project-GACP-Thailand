{
  "name": "gacp-backend",
  "version": "3.8.0",
  "description": "GACP Platform Backend - Production Server (V3.0)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run prisma:generate",
    "postinstall": "prisma generate --schema prisma/schema",
    "prisma:generate": "prisma generate --schema prisma/schema",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:report": "npx playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\" --ignore-path .gitignore",
    "backup": "node scripts/backup-postgresql.js",
    "audit:check": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@gacp/error-reporting": "workspace:*",
    "@gacp/validation": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.2.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.33.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "stripe": "^22.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.15.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.7.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "seed": "node prisma/seed-gacp.js && node prisma/seed-bank-accounts.js"
  }
}
