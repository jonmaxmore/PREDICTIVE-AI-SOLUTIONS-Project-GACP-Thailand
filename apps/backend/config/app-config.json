{
  "app": {
    "name": "Botanical Audit Framework",
    "version": "1.0.0",
    "environment": "development"
  },
  "server": {
    "port": 8000,
    "host": "localhost",
    "cors": {
      "allowedOrigins": [
        "*"
      ],
      "allowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ]
    },
    "rateLimiting": {
      "enabled": true,
      "maxRequests": 100,
      "timeWindow": 60000
    }
  },
  "mongodb": {
    "uri": "mongodb://<USER>:<PASSWORD>@<HOST>/<DB>",
    "options": {
      "maxPoolSize": 10,
      "minPoolSize": 2,
      "serverSelectionTimeoutMS": 5000,
      "socketTimeoutMS": 45000
    },
    "reconnectInterval": 5000,
    "reconnectAttempts": 5
  },
  "logging": {
    "level": "info",
    "format": "combined",
    "errorLogPath": "./logs/error.log",
    "combinedLogPath": "./logs/combined.log"
  },
  "auth": {
    "jwtSecret": "changeme_in_production",
    "jwtExpiration": "24h",
    "refreshTokenExpiration": "7d"
  },
  "storage": {
    "type": "local",
    "localPath": "./uploads",
    "maxFileSize": 10485760
  },
  "features": {
    "enableSocketNotifications": true,
    "enableQuestionnaires": true,
    "enableTraceability": true,
    "enableStandardsComparison": true,
    "enableReporting": true
  },
  "modules": {
    "farmManagement": {
      "enabled": true,
      "maxPlotsPerFarm": 50,
      "maxCropsPerFarm": 100
    },
    "questionnaires": {
      "enabled": true,
      "maxQuestionsPerSection": 50,
      "maxSectionsPerQuestionnaire": 10
    },
    "traceability": {
      "enabled": true,
      "qrCodeBaseUrl": "https://trace.botanical-audit.org/verify"
    },
    "standards": {
      "enabled": true,
      "autoGenerateActionPlans": true
    },
    "reporting": {
      "enabled": true,
      "scheduledReports": true,
      "exportFormats": [
        "json",
        "csv",
        "pdf"
      ]
    }
  }
}