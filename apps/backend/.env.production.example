################################################################################
# GACP Platform - Environment Configuration (.env.example)
################################################################################
# 
# CRITICAL: This file contains EXAMPLES ONLY
# 
# FOR PRODUCTION:
#   1. Copy to .env.production
#   2. Replace ALL placeholder values with REAL, SECURE values
#   3. NEVER commit .env files to git
#   4. Use secrets management system
#   5. Ensure proper file permissions: chmod 600 .env.production
#
# FOR DEVELOPMENT:
#   1. Copy to .env
#   2. Adjust localhost URLs as needed
#
################################################################################

# SERVER CONFIGURATION
PORT=8000
NODE_ENV=development

# DATABASE (PostgreSQL) - PRODUCTION REQUIRED
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# Production: Add ?sslmode=require for encryption
DATABASE_URL="postgresql://gacp:gacp2024@localhost:5432/gacp_db?schema=public"

# REDIS (Cache & Queues) - PRODUCTION REQUIRED
REDIS_URL="redis://localhost:6379"

# JWT/TOKEN SECURITY - PRODUCTION REQUIRED
# Generate with: openssl rand -hex 32
# Minimum 32 characters (64-char hex recommended).
#
# Canonical names (use these for new deployments):
#   HEALTH_JWT_SECRET    — health-portal JWT signing key
#   PROVIDER_JWT_SECRET  — provider-portal JWT signing key
#
# Legacy fallbacks (still accepted by env-validator.js):
#   JWT_SECRET           → falls back for HEALTH_JWT_SECRET
#   DTAM_JWT_SECRET      → falls back for PROVIDER_JWT_SECRET
HEALTH_JWT_SECRET="generate_secure_random_value_with_openssl_rand_hex_32"
PROVIDER_JWT_SECRET="generate_secure_random_value_with_openssl_rand_hex_32"
# Legacy aliases (kept for smooth migration; remove once tooling stops using them)
JWT_SECRET="optional_fallback_for_health_jwt_secret"
DTAM_JWT_SECRET="optional_fallback_for_provider_jwt_secret"
JWT_EXPIRES_IN="24h"
DTAM_JWT_EXPIRES_IN="12h"
JWT_ISSUER="gacp-backend"
JWT_AUDIENCE="gacp-users"

# ENCRYPTION & DATA PROTECTION - PRODUCTION REQUIRED
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="generate_secure_random_value_with_openssl_rand_hex_32"
HMAC_KEY="generate_secure_random_value_with_openssl_rand_hex_32"

# PASSWORD HASHING SECURITY
# Recommended: 12 (balanced), Can use 14-16 for high security
BCRYPT_ROUNDS=12

# MFA ENFORCEMENT (P1-6)
# Set to "true" to require MFA for PROVIDER/ADMIN accounts
REQUIRE_MFA_FOR_PRIVILEGED="false"

# SESSION MANAGEMENT
# Generate with: openssl rand -hex 32
SESSION_SECRET="generate_secure_random_value_with_openssl_rand_hex_32"
COOKIE_DOMAIN="localhost"

# CORS CONFIGURATION
# NEVER use "*" in production
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# PUBLIC URLS
TRACE_BASE_URL="http://localhost:3000"
PUBLIC_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# EMAIL / SMS — REMOVED 2026-09-16. The platform sends neither email nor SMS:
# business notifications are in-app only (operator 2026-08-13), login is
# หมอพร้อม / ThaID with no email second factor (2026-09-15), and there is no
# forgot-password flow by email or SMS (2026-09-16). No code reads a mail relay
# or SMS carrier setting, so none belongs in a production env file. Do not add a
# relay or carrier back without a new operator decision (and keep any future
# one inside Thailand: citizen PII).

# FEATURE FLAGS
# E2E routes are unconditionally blocked in production (no flag needed)

# CONSENT DOCUMENT VERSIONS - OVERRIDE ONLY
# middleware/consent-manager.js stamps this string on every new UserConsent row
# and forces a fresh acceptance when a stored grant does not match it.
# The default no longer depends on this file: PUBLISHED_CONSENT_VERSIONS in
# middleware/consent-manager.js ships the version beside the document, so
# PAYMENT_TERMS resolves to docs/legal/payment-terms-th-v1.2.md (one ค่าบริการ,
# no state part; it supersedes v1.1 and v1) even when this
# line is absent. Categories with no document in the repository still fall back
# to the historical baseline 1.0.0.
# Set this only to pin an OLDER version deliberately.
# Unset means the published default; uncomment ONLY to pin an older version.
# CONSENT_VERSION_PAYMENT_TERMS="payment-terms-th-v1.2"

# LOGGING
LOG_LEVEL="info"

# OBSERVABILITY — error tracking (Sentry)
#
# Re-added 2026-10-02 by operator decision, with personal-data scrubbing
# (packages/error-reporting/src/scrub.js). Off while SENTRY_DSN is empty.
# Read only by config/sentry.js; the release is the image's GIT_SHA.
# Runbook: docs/operations/sentry-error-tracking.md
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=""
