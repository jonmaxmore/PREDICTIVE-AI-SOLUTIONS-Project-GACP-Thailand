// Domain: per-permission GRANT / REVOKE overrides (Wave 2 — "Admin ควบคุม
// permission ได้"). ENGINE model.
//
// The single source of a user's authority is their canonical role's baseline
// (ROLE_PERMISSIONS in shared/canonical-rbac.js). This table is an ADDITIVE
// override layer on top of that baseline, following the standard ERP model:
//
//   effective(user) = ROLE_PERMISSIONS[role] ∪ {GRANT rows} − {REVOKE rows}
//
// Rows are read LIVE per request by services/effective-permissions-service.js
// (they are NOT baked into the JWT), so a grant/revoke takes effect on the
// very next request — no session-epoch bump needed, unlike a role change.
//
// One row per (user, permission): the effect column decides whether that
// permission is added or removed. Mirrors the ADR-016 M2M template
// (UserGroupMembership in user-groups.prisma): composite PK, an
// organizationId mirrored from User for RLS observe-only + tenant scoping,
// FK to users ON DELETE CASCADE (grants die with the user) and FK to
// organizations ON DELETE RESTRICT.

model UserPermissionGrant {
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String // one of PERMISSIONS values (e.g. 'report.export')
  effect     String // 'GRANT' | 'REVOKE'
  reason     String?
  grantedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Mirrored from User.organizationId (RLS observe-only + tenant scoping),
  // like UserGroupMembership.organizationId. Application code keeps it in
  // sync when a user moves tenants (rare); the user row is source of truth.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, permission])
  @@index([userId])
  @@index([organizationId])
  @@map("user_permission_grants")
}
