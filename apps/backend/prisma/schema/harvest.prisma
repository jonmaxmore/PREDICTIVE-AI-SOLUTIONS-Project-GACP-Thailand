// Domain: Harvest & Post-Harvest Processing

// HARVEST BATCH MODEL (รุ่นเก็บเกี่ยว)
// W1-3: this is NOT a "Lot" — batchNumber is minted "BATCH-...", never
// "LOT-...". The packaging Lot ("ชุดบรรจุ", lotNumber "LOT-...") is a
// separate model — see trace.prisma `model Lot`.

model HarvestBatch {
  id        String   @id @default(uuid())
  uuid      String   @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // รหัส Lot
  batchNumber String @unique // เช่น "LOT-2025-001"

  // QR Code Tracking
  qrCode      String? @unique // UUID for public lookup
  trackingUrl String? // Full URL with domain

  // ความสัมพันธ์ (เพิ่ม cycleId)
  cycleId String?
  cycle   PlantingCycle? @relation(fields: [cycleId], references: [id])

  // Relation to Farm
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id])

  // ข้อมูลพืช (Relation to Plant)
  plantCode String? // e.g. "CAN"
  plant     PlantSpecies? @relation(fields: [plantCode], references: [code])

  // วันที่
  harvestDate DateTime @default(now())

  // ผลผลิต
  freshWeight Float // น้ำหนักสด (กก.)
  dryWeight   Float? // น้ำหนักแห้ง (กก.)
  lossWeight  Float? // น้ำหนักสูญเสีย (กก.)

  // คุณภาพ
  moistureContent Float? // ความชื้น (%)
  qualityGrade    String? // A, B, C, REJECT

  // การแปรรูปเบื้องต้น (Primary Processing)
  isDried        Boolean @default(false)
  dryingMethod   String? // SUN_DRY, OVEN_DRY, DEHUMIDIFIER
  dryingTemp     Float? // อุณหภูมิ (C)
  dryingDuration Int? // ระยะเวลา (ชั่วโมง)

  // การตรวจสอบ (QC)
  qcPassed Boolean @default(false)
  qcNotes  String?
  qcBy     String?

  // สถานะ
  status String @default("RECEIVED") // RECEIVED, DRYING, PROCESSED, PACKED, SOLD

  // Audit Trail
  recordedBy String?
  notes      String?

  // Relation to Lots
  lots Lot[]


  // GACP Thai Requirements
  packagingDetails PackagingDetail[]
  dryingProcesses  DryingProcess[]
  labResults       BatchLabResult[]

  // Soft Delete
  isDeleted Boolean @default(false)

  // Tenancy (ADR-014, Phase 1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([batchNumber])
  @@index([status])
  @@index([organizationId])
  // DB-06: index FK columns
  @@index([cycleId])
  @@index([farmId])
  @@index([plantCode])
  @@map("harvest_batches")
}

// NOTE: Legacy provider model removed — provider auth now uses providerId on User model

// DRYING TEMPERATURE (ข้อมูลอุณหภูมิการตาก)

model DryingTemperature {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reference
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id])

  // Readings
  temperature Float // Celsius
  humidity    Float // %
  timestamp   DateTime

  // Audit
  createdBy  String?
  recordedBy String?

  // Tenancy (ADR-014, Phase 1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([farmId])
  @@index([timestamp])
  @@index([organizationId])
  @@map("drying_temperatures")
}

