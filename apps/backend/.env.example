# Server Configuration
PORT=8000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://gacp:gacp2024@localhost:5432/gacp_db?schema=public"

# Redis (Cache & Queues)
# If using URL format:
REDIS_URL="redis://localhost:6379"
# Or individual host/port:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Security
JWT_SECRET="change_this_to_a_secure_random_string"
CORS_ORIGIN="http://localhost:3000,https://localhost,https://gacpth.com"
ENCRYPTION_KEY="must_be_32_bytes_long_random_string_!!!" # 32 chars
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=1000         # Max requests per window

# ─── JWT: per-audience secrets ───────────────────────────────────────────────
# Health (applicant) tokens fall back to JWT_SECRET above. Provider (officer)
# tokens do NOT — they need their own secret, and jwt-security throws
#   "CRITICAL: JWT secrets are missing"
# on boot when it is absent, so the backend will not start in production
# without this line. That failure is deliberate: a shared secret between the
# applicant and officer audiences would let an applicant token be replayed as
# an officer one.
PROVIDER_JWT_SECRET="change_this_to_a_different_secure_random_string"
# DTAM_JWT_SECRET is the older name for the same value. Set PROVIDER_JWT_SECRET
# on new deployments; this is read only as a fallback.
# DTAM_JWT_SECRET=""

# Token lifetimes and claims. Defaults in brackets are used when unset.
JWT_ISSUER="gacp-backend"                 # [gacp-backend]
JWT_AUDIENCE="gacp-health"                # [gacp-health]  applicant audience
JWT_EXPIRES_IN="24h"                      # [24h]          applicant access token
PROVIDER_JWT_AUDIENCE="gacp-provider"     # [gacp-provider]
PROVIDER_JWT_EXPIRES_IN="12h"             # [12h]          officer access token
# Older names, read only as fallbacks for the two above.
# DTAM_JWT_AUDIENCE=""
# DTAM_JWT_EXPIRES_IN=""

# ─── Token migration grace windows ───────────────────────────────────────────
# Both are ISO-8601 instants. A malformed or unset value fails CLOSED (strict).
#
# BLOCKING ON THE NEXT DEPLOY. Access tokens issued before the token-type claim
# shipped carry no `tokenType`. The allowlist accepts an untyped token only
# inside this window; with it unset, every already-issued session is rejected on
# its first authenticated call and the whole platform is logged out at once.
# Set it to deploy time + 25h (one hour past the longest access-token TTL:
# health 24h, provider 12h), then REMOVE the line once the window has passed.
LEGACY_UNTYPED_TOKEN_GRACE_UNTIL=""
# The same pattern for tokens issued before the `jti` claim existed. Unset means
# strict; set it only while such tokens can still be in circulation.
LEGACY_NO_JTI_GRACE_UNTIL=""

# ─── Secret backend ──────────────────────────────────────────────────────────
# Where config/secrets.js reads catalogued secrets from (bank account numbers,
# DATABASE_URL, PAYMENT_WEBHOOK_SECRET, ...). "env" reads them from this file; "file"
# reads one file per secret out of SECRETS_DIR (Docker/K8s secret mounts).
SECRET_BACKEND="env"                      # [env] | file
SECRETS_DIR="/run/secrets"                # [/run/secrets] used when SECRET_BACKEND=file

# ─── Audit chain integrity ───────────────────────────────────────────────────
# Keys the hash chain that makes audit rows tamper-evident. Changing it after
# rows exist breaks verification of everything written under the old key, so
# set it once, at first deploy, and treat it as permanent.
AUDIT_HASH_KEY=""
# Set to "true" to key the chain with HMAC rather than a plain hash.
AUDIT_HASH_HMAC="false"                   # [false]

# ─── Identity lookup ─────────────────────────────────────────────────────────
# "true" makes national-ID lookups use the keyed-HMAC columns instead of the
# plaintext ones. Flip only in step with the H-4 dual-write rollout.
AUTH_LOOKUP_USE_HMAC="false"              # [false]

# ─── Interop partners ────────────────────────────────────────────────────────
# Comma-separated API keys permitted on the partner interop endpoints. Empty
# disables partner access entirely (fail-closed).
INTEROP_PARTNER_API_KEYS=""

# ─── Organisation identity on invoices and receipts ──────────────────────────
# These are printed on documents a farmer receives and files for tax, so a
# wrong value is a compliance problem rather than a cosmetic one. The BANK
# ACCOUNT NUMBERS and PromptPay IDs are deliberately NOT templated here — they
# come from the secret backend (see config/secrets.js).
# The eight DTAM_* rows that stood here were removed 2026-09-11: the operator
# retired the second issuer, so nothing in the tree reads them any more. A
# template row for a variable no code reads is an instruction to configure
# something that cannot take effect.
PLATFORM_COMPANY_NAME_TH=""
PLATFORM_COMPANY_NAME_EN=""
PLATFORM_ADDRESS_LINE1=""
PLATFORM_ADDRESS_LINE2=""
PLATFORM_TAX_ID=""                        # 13 digits
PLATFORM_REGISTRATION_NO=""
PLATFORM_BANK_ACCOUNT_NAME=""
# Printed on the letterhead of every quotation / billing note / receipt.
PLATFORM_CONTACT_PHONE=""
PLATFORM_CONTACT_EMAIL=""

# External Services / Public URLs
TRACE_BASE_URL="http://localhost:3000"
PUBLIC_URL="http://localhost:3000"

# REMOVED 2026-09-16: the email block (mail on/off, provider, relay host, port,
# user, password and sender address). The platform sends no email and has no
# forgot-password flow by email or SMS (operator 2026-09-15 / 2026-09-16); the
# last reader, services/email-service.js, was deleted on 2026-09-15.

# Public base URL of this deployment (used when building absolute links).
APP_URL="http://localhost:3000"
# Read by server.js for the CORS allow-list (comma-separated origins allowed).
FRONTEND_URL="http://localhost:3000"

# Feature Flags
ENABLE_E2E_ROUTES="false"
DEMO_MODE="false"

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"
MINIO_BUCKET="gacp-uploads"
MINIO_USE_SSL="false"



# REMOVED 2026-08-19 (external-services cleanup Task 3): SMS_PROVIDER,
# SMS_API_KEY, SMS_HTTP_TIMEOUT_MS. The SMS stack (services/sms/sms-service.js,
# services/notification/providers/sms-provider.js) is deleted — the operator
# decision (2026-08-13, shared/notification-view.js:16-19) made the in-app
# inbox the only business-notification channel.

# REMOVED 2026-07-25 (data-sovereignty pass): LINE_NOTIFY_TIMEOUT_MS. The
# LINE Notify service that used it posted citizen notification text to
# notify-api.line.me (LY Corp, Japan) and has been deleted; LY Corp also
# retired LINE Notify in 2025.

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
# Re-added 2026-10-02 by operator decision, with personal-data scrubbing
# (packages/error-reporting/src/scrub.js). OFF while SENTRY_DSN is empty: the
# SDK is not even loaded and nothing is sent. Read only by config/sentry.js.
# Never commit a real DSN here — it goes in the deploy env file
# (/opt/gacp-platform/.env.staging, .env.demo). Runbook:
# docs/operations/sentry-error-tracking.md
SENTRY_DSN=""                     # backend project DSN; empty = off
SENTRY_ENVIRONMENT=""             # staging | demo; empty → GACP_DEPLOY_SLOT, then NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=""      # 0..1; empty → 0.05
# The release is the image's GIT_SHA build arg — nothing to set here.

# ─── Slip-flow SLA monitor ───────────────────────────────────
# Hours a slip can sit in PENDING_REVIEW before the 10:00 cron alerts
# ACCOUNT users. Default 24. Bump for relaxed SLAs, drop for tighter.
SLIP_SLA_HOURS="24"

# ─── Lab Integration Webhook ─────────────────────────────────
# /api/callbacks/lab-result requires BOTH the static API key (legacy)
# AND a per-request HMAC signature in the x-webhook-signature header.
# In production both must be set or the route returns 503.
LAB_API_KEY=""                    # Static bearer key the lab gateway sends
LAB_WEBHOOK_SECRET=""             # HMAC secret shared with the lab gateway

# ─── MFA Enforcement ─────────────────────────────────────────
# Set to "true" to require MFA for PROVIDER and ADMIN roles
REQUIRE_MFA_FOR_PRIVILEGED="false"

# ─── Cookie Security ─────────────────────────────────────────
COOKIE_SECURE="true"              # Set to "true" in production (HTTPS)


# ─── Consent document versions ───────────────────────────────────────────────
# CONSENT_VERSION_<CATEGORY> is the version string middleware/consent-manager.js
# stamps on every new UserConsent row, and the string a stored grant is compared
# against when a gate asks "is this consent still current?".
#
# It is an OVERRIDE, not the only source. A category whose document lives in
# this repository gets its default from PUBLISHED_CONSENT_VERSIONS in
# middleware/consent-manager.js, which ships with the document; every other
# category still falls back to the historical baseline 1.0.0. PAYMENT_TERMS
# therefore resolves to docs/legal/payment-terms-th-v1.2.md even when this line
# is absent, and __tests__/unit/consent-version-matches-the-published-document
# .test.js keeps that default equal to the newest document on disk.
#
# Set it only to pin an OLDER version deliberately. Publishing new terms is a
# code change (the document plus that default), so the deploy cannot lose the
# bump: v1.1 corrected a fee table that printed a total LOWER than the platform
# collects, and v1.2 (effective 4 ตุลาคม 2569) states one ค่าบริการ with no state
# part; every applicant who accepted an earlier version is asked to accept once more.
# Unset means the published default; uncomment ONLY to pin an older version.
# CONSENT_VERSION_PAYMENT_TERMS="payment-terms-th-v1.2"

# ─── Stripe Payment Gateway (Wave 1 — single lump-sum checkout) ──────────────
# Server-side ONLY. Never commit real values; never expose the secret or the
# webhook secret to any frontend bundle. The publishable key (pk_...) is the
# ONLY Stripe credential a client ever sees, and the BACKEND hands it out with
# each checkout (PromptPay QR step 2026-09-27) — it is not baked into a web build.
STRIPE_SECRET_KEY=""              # sk_live_/sk_test_ — Payment Intents API. Absent → checkout creation fails closed.
STRIPE_PUBLISHABLE_KEY=""         # pk_test_/pk_live_ of the SAME account and mode as STRIPE_SECRET_KEY. Absent, not a pk_ key, or a different mode → checkout refuses before minting (503). Dev fallback name: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
STRIPE_WEBHOOK_SECRET=""          # whsec_ — signature verification for /api/v1/webhooks/stripe. Absent → the webhook route refuses to boot (fail-closed, same posture as PROVIDER_JWT_SECRET).
STRIPE_CHECKOUT_ENABLED="false"   # Wave 2 drain-then-purge flag: "true" opens POST /api/payments/checkout (Stripe rail). Anything else → 503 STRIPE_CHECKOUT_DISABLED; the legacy slip surface keeps serving in-flight applications.
PAYMENT_ADAPTER="stripe"          # W2-01 gateway seam: stripe (default) | mock. mock = deterministic no-network adapter for QA/E2E while keys are pending; unknown values fail closed.

# ─── Session / OAuth state signing ───────────────────────────────────────────
# Signs the IdP OAuth `state` anti-CSRF cookie (idp_state) — HMAC-SHA256,
# declared at config/secrets.js:127-132 ("Session signing secret (cookies,
# OAuth state)"), required≥32 chars, NO devFallback. Absent → BOTH IdP
# endpoints fail closed with AUTH_STATE_SECRET_MISSING before doing anything
# else (routes/api/auth/auth-idp.js stateSecret(), checked at the top of both
# POST /:provider/authorize-url and POST /:provider/callback).
# Generate: openssl rand -hex 32
SESSION_SECRET=""

# ─── AUTH providers — AUTH-01 (registry SSOT: config/auth-providers.js) ───────
# ทุก endpoint/parameter อ้างคู่มือทางการใน evidence/AUTH-01/manual-citations.md
# state ต่อ provider: enabled | staging_only | coming_soon
# default เมื่อไม่ตั้งค่า: local=enabled (TRANSITIONAL ตาม mandate §C4),
# healthid/providerid/thaid=coming_soon (ธง B1-CRED — ยังไม่มี credentials จริง)
# fail-closed: provider ที่ env ข้างล่างไม่ครบ ไม่มีทางเป็น enabled ได้จริง
# AUTH_LOCAL_STATE=""
# AUTH_HEALTHID_STATE=""
# AUTH_PROVIDERID_STATE=""
# AUTH_THAID_STATE=""

# ตัวบอกว่า process นี้คือ "ช่อง staging" — ตั้งได้ที่เดียวคือ docker-compose.staging.yml
# (เทสต์ปักไว้: staging-slot-compose-pin.test.js ห้ามไฟล์ compose อื่นมีบรรทัดนี้เด็ดขาด)
# เหตุที่มี: กันชั้นสอง (defense in depth) — staging รัน NODE_ENV=staging อยู่แล้ว marker นี้
# มีผลเดียว: provider ที่ state เป็น staging_only ยัง resolve เปิดได้แม้ NODE_ENV เพี้ยนเป็น
# production โดยไม่ตั้งใจ (auth-providers.js) · ห้ามตั้งใน .env ใด ๆ
# GACP_DEPLOY_SLOT="staging"

# Timeout ของ HTTP ขาออกไป IdP ทุกตัว (AbortController), ms. Default 10000.
# AUTH_IDP_TIMEOUT_MS="10000"

# ── Health ID (สธ.) — ฝั่งเกษตรกร/ประชาชน ──
# Base URL ([P-OAUTH] คู่มือ 1 ก.ค. 67 หน้า 2): UAT https://uat-moph.id.th | Production https://moph.id.th
AUTH_HEALTHID_CLIENT_ID=""
AUTH_HEALTHID_CLIENT_SECRET=""
AUTH_HEALTHID_REDIRECT_URI=""         # ต้องลงทะเบียนกับ Health ID ([P-OAUTH] หน้า 3)
AUTH_HEALTHID_AUTHORIZE_URL=""        # {HealthID-URL}/oauth/redirect ([P-OAUTH] หน้า 3)
AUTH_HEALTHID_TOKEN_URL=""            # {HealthID-URL}/api/v1/token ([P-OAUTH] หน้า 4)
AUTH_HEALTHID_PROFILE_URL=""          # ยังไม่มีในเอกสาร — [P-OAUTH] ไม่มี profile endpoint ฝั่งประชาชน (BLOCKER-2) ห้ามเดา รอเอกสาร Health ID ประชาชน

# ── Provider ID (สธ.) — ฝั่งเจ้าหน้าที่ (OAuth ผ่าน Health ID สองขา) ──
# Provider Base URL ([P-OAUTH] หน้า 6): UAT https://uat-provider.id.th | Production https://provider.id.th
# credential สองคู่ **คนละการลงทะเบียน** (audit F1; manual-citations.md:59,78,95):
#   คู่ที่ 1 ลงทะเบียนกับ Health ID   = CLIENT_ID + CLIENT_SECRET (ขา authorize/แลก code)
#   คู่ที่ 2 ของระบบ Provider ID      = PID_CLIENT_ID + SECRET_KEY (ขา token exchange + profile)
AUTH_PROVIDERID_CLIENT_ID=""          # client_id ที่ลงทะเบียนกับ Health ID ([P-OAUTH] หน้า 3-4)
AUTH_PROVIDERID_CLIENT_SECRET=""      # ใช้ขาแลก code → Health ID token ([P-OAUTH] หน้า 4)
AUTH_PROVIDERID_REDIRECT_URI=""       # ต้องลงทะเบียนกับ Health ID ([P-OAUTH] หน้า 3)
AUTH_PROVIDERID_AUTHORIZE_URL=""      # {HealthID-URL}/oauth/redirect ([P-OAUTH] หน้า 3)
AUTH_PROVIDERID_TOKEN_URL=""          # {HealthID-URL}/api/v1/token ([P-OAUTH] หน้า 4)
AUTH_PROVIDERID_PID_CLIENT_ID=""      # Client-ID ของระบบ Provider ID — คนละการลงทะเบียนกับคู่ Health ID ข้างบน ([P-OAUTH] หน้า 7 token exchange + หน้า 9 header client-id)
AUTH_PROVIDERID_SECRET_KEY=""         # secret_key ของระบบ Provider ID คู่กับ PID_CLIENT_ID ([P-OAUTH] หน้า 7)
AUTH_PROVIDERID_TOKEN_EXCHANGE_URL="" # {Provider-URL}/api/v1/services/token ([P-OAUTH] หน้า 7)
AUTH_PROVIDERID_PROFILE_URL=""        # {Provider-URL}/api/v1/services/profile ([P-OAUTH] หน้า 9)

# ── ThaID (กรมการปกครอง) — adapter ลงแล้ว (services/auth/idp/thaid-adapter.js);
# endpoints + scopes อ้าง [T-SBX]/[T-PRD] §6 ใน evidence/AUTH-01/manual-citations.md
# REQUIRED_ENV.thaid (config/auth-providers.js) ต้องครบ 6 ตัวข้างล่าง (ไม่รวม
# INTROSPECT_URL — ดูหมายเหตุ) ไม่งั้น fail-closed เป็น coming_soon ──
AUTH_THAID_CLIENT_ID=""
AUTH_THAID_CLIENT_SECRET=""
AUTH_THAID_REDIRECT_URI=""            # ต้องเป็นค่าที่ลงทะเบียนกับกรมการปกครอง ([T-SBX]/[T-PRD] §6.1.1); sandbox cred กลางกำหนดเป็นอะไรก็ได้ ([T-SBX] §9)
AUTH_THAID_AUTHORIZE_URL=""           # .../api/v2/oauth2/auth/ ([T-SBX]/[T-PRD] §6.1.1 หน้า 7)
AUTH_THAID_TOKEN_URL=""               # .../api/v2/oauth2/token/ ([T-SBX]/[T-PRD] §6.2.1 หน้า 10)
AUTH_THAID_SCOPE=""                   # แนะนำ "openid pid given_name family_name" — เมื่อขอ openid ค่า pid/given_name/
                                       # family_name จะย้ายเข้าไปอยู่ใน id_token แทนที่จะมากับ token response ตรง ๆ
                                       # (§6.2.2 หมายเหตุ **) — adapter/identity-service (Task 4) อ่านทั้งสองที่:
                                       # ใน id_token ก่อน แล้ว fallback ไปที่ top-level ถ้าไม่มี ไม่ต้องเดาว่า BORA
                                       # sandbox จะตอบทรงไหน ([T-SBX]/[T-PRD] §6.1.1 (20)) — ห้าม hardcode ในโค้ด (Law 3.5)
# AUTH_THAID_INTROSPECT_URL="" # .../api/v2/oauth2/introspect/ ([T-SBX]/[T-PRD] §6.3) — OPTIONAL (Task 4):
# ไม่อยู่ใน REQUIRED_ENV.thaid อีกต่อไป เพราะ login flow ปัจจุบัน (resolveThaidSession)
# ไม่เรียก introspect เลย (identity มากับ token/id_token ตรงอยู่แล้ว) — ตั้งไว้เผื่อ
# getProfile() ในอนาคตอยากยืนยัน token ยัง active ผ่าน BORA เอง
# หมายเหตุ: [T-SBX] §9 แจก api_key มาใน credential ชุด sandbox ด้วย แต่ไม่มีตัวอย่าง request
# ใน §6.1-6.3 (OAuth legs) ที่ใช้มันเลย — คาดว่าเป็นของ BORA data APIs อื่น; adapter จึงยังไม่ส่ง
# ถ้ายิง sandbox จริงแล้ว BORA ปฏิเสธเพราะขาด api_key ค่อยเพิ่ม AUTH_THAID_API_KEY (env-only)

# ── การเลิกใช้ API เดิม (deprecation) ───────────────────────────────
# วันหมดอายุของ POST /api/planting-cycles/:id/harvest — ประตูบันทึกเก็บเกี่ยว
# แบบครั้งเดียวจบ ที่ถูกแทนด้วย /harvest-batches (แยกตามแปลง) ค่านี้ถูกส่งกลับ
# ใน header Sunset ให้ผู้เชื่อมต่อระบบเห็นล่วงหน้า
#
# ตั้งเป็นสิ้นปี 2026 เพราะรอบปลูกหนึ่งรอบกินเวลาเป็นเดือน ผู้เชื่อมต่อจึงควรมีเวลา
# เต็มหนึ่งฤดูกาลในการย้าย ไม่ใช่แค่ไม่กี่สัปดาห์
#
# ปล่อยว่างไว้ได้ — config/api-deprecation-policy.js มีค่าตั้งต้นเดียวกันนี้อยู่แล้ว
# ตั้งค่านี้เมื่อจะเลื่อนวันออกไป หรือย่นเข้ามาหลังจากผู้เชื่อมต่อย้ายครบแล้ว
PLANTING_HARVEST_LEGACY_SUNSET=""

# ── ที่อยู่สาธารณะของแพลตฟอร์ม (config/public-urls.js) ────────────────────────
#
# ที่เดียวที่โค้ดอ่านตัวแปรกลุ่มนี้ · บน production ถ้าไม่ตั้งค่า ระบบจะ **ปฏิเสธ
# พร้อมบอกชื่อตัวแปรที่ต้องตั้ง** ไม่ใช่เดาโดเมนเอง — เพราะ staging ที่ลืมตั้งเคย
# ทำให้ URL ของ production ไปโผล่บนใบแจ้งหนี้ สติกเกอร์ QR และหนังสือแจ้งลบข้อมูล
# และสติกเกอร์ที่ติดกล่องไปแล้วเรียกคืนไม่ได้
#
# APP_PUBLIC_URL / STAGING_PUBLIC_URL / APP_URL / PUBLIC_APP_URL
#   ที่อยู่ของเว็บฝั่งผู้ยื่น — ตัวใดตัวหนึ่งก็พอ เรียงตามลำดับความสำคัญ
# TRACE_BASE_URL / PUBLIC_TRACE_URL
#   ปลายทางที่ QR บนกล่องชี้ไป
# CERT_VERIFY_BASE_URL
#   ที่อยู่ตรวจสอบใบรับรอง — เป็น base **เต็มรวม path** (ลงท้าย /verify)
#   ถ้าไม่ตั้ง จะประกอบจากที่อยู่เว็บข้างบนให้เอง
CERT_VERIFY_BASE_URL=""

# ── ตัวตรวจการอ่านข้อมูลฝั่งผู้ยื่น (config/holder-read-witness.js) ───────────────
# เมื่อผู้ใช้ health อ่านข้อมูลที่มีผู้ถือ (คำขอ แปลง ใบรับรอง ใบแจ้งหนี้ ฯลฯ) โดยไม่ได้
# จำกัดขอบเขตด้วย holderReadWhere ตัวตรวจจะนับ health_read_unscoped_total{model,op}
# และบันทึก log สัญญาณ HEALTH_READ_UNSCOPED พร้อม route
#   off    — ไม่ตรวจ
#   shadow — นับและบันทึก แต่ปล่อยให้อ่านต่อ (ค่าตั้งต้น · ไม่ตั้งหรือตั้งผิดก็เป็น shadow)
#   throw  — นับ บันทึก แล้วปฏิเสธการอ่านด้วยรหัส HEALTH_READ_UNSCOPED (ใช้ในเทส)
#            ถูกปฏิเสธในสภาพแวดล้อมที่ deploy แล้ว: NODE_ENV=production|staging หรือ
#            SENTRY_ENVIRONMENT=production|staging|demo → ลดเป็น shadow และบันทึกคำเตือน
#            (บางเส้นทางยังกลืน error ของการอ่านเอง การปฏิเสธจะทำให้การเขียนหายเงียบ)
HOLDER_READ_WITNESS=""

# SENTRY_ENVIRONMENT
#   ชื่อสภาพแวดล้อมที่ deploy (production / staging / demo) — Sentry ใช้ติดป้ายเหตุการณ์
#   และตัวตรวจการอ่านใช้ตัดสินว่าห้ามโหมด throw ที่นี่ (ตั้งใน docker-compose ของแต่ละสภาพแวดล้อม)
SENTRY_ENVIRONMENT=""
