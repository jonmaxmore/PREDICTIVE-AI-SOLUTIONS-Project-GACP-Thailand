# ============================================================
# GACP Platform - Local Development Environment Variables
# Copy this file to .env.local and update the values
# ============================================================

# ============================================================
# Database Configuration
# ============================================================
DB_USER=gacp
DB_PASSWORD=change-me-local
DB_NAME=gacp_db
DATABASE_URL=postgresql://gacp:change-me-local@localhost:5432/gacp_db?schema=public

# ============================================================
# JWT Secrets (Generate strong random strings for production)
# ============================================================
JWT_SECRET=local-jwt-secret-change-this-in-production
DTAM_JWT_SECRET=local-dtam-secret-change-this-in-production
JWT_EXPIRES_IN=8h

# ============================================================
# Redis Configuration
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# Server Configuration
# ============================================================
NODE_ENV=production
PORT=8000
HOST=0.0.0.0

# ============================================================
# CORS & Security
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGIN=https://localhost,https://127.0.0.1,https://192.168.1.*,capacitor://localhost,ionic://localhost

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# Mobile Support
# ============================================================
MOBILE_API_ENABLED=true
ALLOW_EMULATOR_TRAFFIC=true
MOBILE_DEEP_LINK_SCHEME=gacp

# ============================================================
# Payment Gateway — Stripe (the ONLY gateway). The old PAYMENT_GATEWAY=MOCK /
# PAYMENT_PUBLIC_KEY / PAYMENT_SECRET_KEY vars were dead AND misleading — they
# pointed readers at a gateway the code never uses (the real Phase-0 mix-up,
# the backlog). Authoritative list: apps/backend/.env.example:178-181.
# The slip-upload rail is legacy and draining — not the gateway.
# ============================================================
PAYMENT_ADAPTER=stripe                  # stripe (default) | mock (deterministic no-network adapter for E2E/QA without keys)
STRIPE_CHECKOUT_ENABLED=false           # "true" opens POST /api/payments/checkout (the Stripe rail); else 503
STRIPE_SECRET_KEY=sk_test_xxx           # sk_test only for local/dev — never sk_live
STRIPE_WEBHOOK_SECRET=whsec_xxx         # from `stripe listen` — verifies inbound Stripe webhook signature
NEXT_PUBLIC_CHECKOUT_UI_ENABLED=true    # exact "true" renders /health/payments/checkout + the pay button; off = no way for an applicant to pay (slips retired) — same default as apps/web-app/Dockerfile since 2026-08-27
PAYMENT_WEBHOOK_SECRET=whsec_local      # kept: still read by config/secrets.js (inbound webhook HMAC)

# Shared secret gating the mutating E2E test routes (/api/v1/e2e/*). The router
# is never mounted in production; on staging/dev it is fail-closed — if E2E_SECRET
# is unset, every /e2e/* request is rejected (401). Set this AND send it as the
# `x-e2e-secret` header from the test harness to run the golden-scenario / reset.
E2E_SECRET=local-e2e-secret-change-me

# For real payment testing: get a Stripe test-mode key (sk_test_…), then set
# STRIPE_SECRET_KEY + STRIPE_CHECKOUT_ENABLED=true + NEXT_PUBLIC_CHECKOUT_UI_ENABLED=true,
# and run: stripe listen --api-key sk_test_… --forward-to localhost:8000/api/webhooks/stripe

# Email / SMS: none — no mail relay or SMS carrier to configure (operator
# 2026-09-16: no email, no forgot-password by email or SMS).

# ============================================================
# File Upload
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_DIR=./logs

# ============================================================
# Feature Flags
# ============================================================
ENABLE_E2E_ROUTES=true
ENABLE_SWAGGER=true

# ============================================================
# Proxy/IP Security
# ============================================================
# Trust private proxy hops (Docker/Nginx). Set false if backend is directly internet-facing.
TRUST_PRIVATE_PROXY_RANGES=true
# Optional explicit trusted proxy IPs (comma-separated). Example: 127.0.0.1,172.20.0.2
# TRUSTED_PROXY_IPS=

# Lab Integration (for production)
# LAB_API_URL=https://lab-api.example.com
# LAB_API_KEY=your-api-key

# Gov-to-gov interoperability partner API keys (SEC-AUDIT-012).
# JSON object {partnerId: secret} guarding the /api/interoperability/v1
# bulk-export + signed-envelope endpoints. Fail-closed: if unset, those
# endpoints reject every caller. Single-certificate verification stays public.
# INTEROP_PARTNER_API_KEYS={"moph":"replace-with-strong-random-secret"}

# ============================================================
# Maps — data sovereignty (fail closed, not fail abroad)
# ============================================================
# Farm coordinates are citizen PII under PDPA. A map tile request encodes the
# area being viewed, so whoever serves the tiles learns roughly where a Thai
# farm is — plus the citizen's IP — on every map view. There is deliberately
# NO built-in default: point these at a source you control (an in-country
# provider, a self-hosted TileServer-GL / OSM mirror, or a same-origin backend
# proxy). Leave them unset and the maps render an honest "ยังไม่ได้ตั้งค่าแผนที่"
# state with the coordinates as text — nothing is drawn from a foreign server.
#
# Enforced by scripts/ci/check-data-sovereignty.js and pinned by
# apps/web-app/src/lib/config/__tests__/map-tiles.test.ts.
#
# Tile template. Must contain {z}, {x} and {y} or it is rejected as a typo.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.go.th/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_URL=/api/map-tiles/{z}/{x}/{y}.png   # same-origin proxy
#
# Credit line the tile source requires (optional).
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=กรมการแพทย์แผนไทยและการแพทย์ทางเลือก
#
# "Open this location in a map" links (auditor inspection summary, provider
# application detail). Must contain {lat} and/or {lng}; every occurrence is
# substituted. Unset means those links simply do not render — the coordinates
# are shown as selectable text instead.
# NEXT_PUBLIC_MAP_VIEWER_URL=https://maps.example.go.th/?lat={lat}&lng={lng}
#
# Mobile app (Flutter) uses the same contract via --dart-define:
#   flutter build apk --dart-define=MAP_TILE_URL=https://tiles.example.go.th/{z}/{x}/{y}.png \
#                     --dart-define=MAP_TILE_ATTRIBUTION='กรมการแพทย์แผนไทยและการแพทย์ทางเลือก'
