# engines.node in package.json is a pin (24.x), matching CI (.github/workflows/
# ci.yml NODE_VERSION) and both Dockerfiles (apps/web-app, apps/backend: FROM
# node:24-alpine). Without engine-strict, pnpm only WARNS on a Node mismatch and
# installs anyway — a build on the wrong major then just silently differs
# instead of failing loudly. design-reproducibility/01-build-identity.
engine-strict=true
