{
  "name": "@gacp/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seeds (กฎเป็นข้อมูล) และ client ของฐานข้อมูล",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema --shadow-database-url \"$GACP_DATABASE_DIRECT_URL\" --exit-code",
    "db:dev": "node scripts/dev-db.ts",
    "seed:law": "node scripts/seed-law.ts",
    "platform-operator:bootstrap": "node scripts/platform-operator-bootstrap.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@gacp/contracts": "workspace:*",
    "@gacp/domain": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "7.10.0",
    "vitest": "^5.0.0"
  }
}
