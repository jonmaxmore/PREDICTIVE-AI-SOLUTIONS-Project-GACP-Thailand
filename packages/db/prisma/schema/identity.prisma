enum UserRole {
  APPLICANT
  FINANCE_OFFICER
  DISPATCHER
  DOCUMENT_REVIEWER
  FIELD_INSPECTOR
  CERTIFICATE_APPROVER
  SYSTEM_ADMIN

  @@map("user_role")
}

enum IdentityProvider {
  THAID
  MORPHROM
  DEV_LOCAL

  @@map("identity_provider")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  displayName String    @map("display_name")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz(6)

  identities           UserIdentity[]
  sessions             Session[]
  staffRoleAssignments StaffRoleAssignment[]
  applicantMembers     ApplicantMember[]

  @@map("users")
}

// ตัวตนจากผู้ให้บริการยืนยันตัวตน เก็บเฉพาะ HMAC ของ subject/เลขบัตร ไม่เก็บ plaintext
model UserIdentity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  provider    IdentityProvider
  subjectHmac String           @map("subject_hmac")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime?        @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subjectHmac])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// หนึ่งคนถือได้หลายบทบาท ไม่มีบทบาทผสม บทบาทที่เพิกถอนแล้วคงแถวไว้เป็นประวัติ
model StaffRoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         UserRole
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?   @map("revoked_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role])
  @@map("staff_role_assignments")
}
