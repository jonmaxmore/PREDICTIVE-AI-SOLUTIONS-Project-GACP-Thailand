// พืชที่ระบบรองรับ กัญชาก่อน พืชอื่นเพิ่มเมื่อกรมส่งฟอร์ม โดยมีชุดกฎของตัวเอง ไม่ reuse ของกัญชา
model Plant {
  code           String   @id
  nameTh         String   @map("name_th")
  scientificName String?  @map("scientific_name")
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications             Application[]
  documentRequirementRules DocumentRequirementRule[]
  feeSchedules             FeeSchedule[]
  inspectionChecklistItems InspectionChecklistItem[]
  certificateTerms         CertificateTerm[]

  @@map("plants")
}
