{
  "name": "@gacp/ui",
  "version": "0.0.0",
  "private": true,
  "description": "design tokens ของ The Official Green Register และ formatter ภาษาไทย (วันที่ พ.ศ. เงินบาทจากสตางค์)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.0"
  }
}
