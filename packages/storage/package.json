{
  "name": "@gacp/storage",
  "version": "0.0.0",
  "private": true,
  "description": "ที่เก็บไฟล์เอกสารหลัง interface เดียว: ดิสก์ในเครื่อง (dev/test) และ Supabase Storage ผ่าน S3 protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@gacp/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.0"
  }
}
