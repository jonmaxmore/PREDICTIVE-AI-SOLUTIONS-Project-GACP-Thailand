{
  "name": "@gacp/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "ชุดค่าปิด, schema ของ env และรูปร่างข้อมูลที่ทุกแอปใช้ร่วมกัน (แหล่งเดียวของชื่อ field)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
