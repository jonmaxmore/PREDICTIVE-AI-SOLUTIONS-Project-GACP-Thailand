# ============================================================
# GACP Platform - Production Environment Variables
# ============================================================
# Copy this file to .env.production and update values
# DO NOT commit .env.production to git!
# ============================================================

# ------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------
DB_USER=gacp
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=gacp_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# ------------------------------------------------------------
# CACHE (Redis)
# ------------------------------------------------------------
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------
# SECURITY (JWT)
# ------------------------------------------------------------
# Each MUST be at least 32 chars. Generate with: openssl rand -base64 64
# HEALTH_JWT_SECRET is the canonical name (JWT_SECRET kept as legacy fallback).
HEALTH_JWT_SECRET=CHANGE_THIS_WITH_OPENSSL_RAND_BASE64_64
JWT_SECRET=${HEALTH_JWT_SECRET}
# PROVIDER_JWT_SECRET is the canonical name (DTAM_JWT_SECRET kept as legacy fallback).
PROVIDER_JWT_SECRET=CHANGE_THIS_WITH_DIFFERENT_SECRET
DTAM_JWT_SECRET=${PROVIDER_JWT_SECRET}

# Token TTLs (override only if you understand the security trade-offs)
# JWT_EXPIRES_IN=24h
# PROVIDER_JWT_EXPIRES_IN=12h
# JWT_ISSUER=gacp-backend
# JWT_AUDIENCE=gacp-health
# PROVIDER_JWT_AUDIENCE=gacp-provider

# Bcrypt cost (OWASP minimum 12). Keep ≥12 in production.
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# SECURITY (Encryption / HMAC) — REQUIRED in production
# ------------------------------------------------------------
# 32+ chars. Used for AES envelope of PII (idCard, etc).
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_32CHARS_OR_MORE
# Optional: separate master key for security-compliance fallback.
MASTER_ENCRYPTION_KEY=CHANGE_THIS_MASTER_ENCRYPTION_KEY
# HMAC for signed application links / tokens (recommended).
HMAC_KEY=CHANGE_THIS_HMAC_KEY
# Optional: dedicated key for the short-lived /uploads signed download URLs
# (W1-2). Leave UNSET to reuse HMAC_KEY above — the backend domain-separates it
# before signing, so the two uses can never be replayed into each other. Set it
# only when you want the two rotated independently. 32+ chars.
# UPLOADS_URL_SIGNING_SECRET=
# Session secret used by cookie sessions (where applicable).
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET
# Set to your apex domain for production cookies.
COOKIE_DOMAIN=gacpth.com
# Force secure cookies (HTTPS only). Set to false only for HTTP staging.
COOKIE_SECURE=true

# ------------------------------------------------------------
# SECURITY (MFA / Privileged Access)
# ------------------------------------------------------------
# Set to 'true' to require MFA for ADMIN / provider roles at login.
REQUIRE_MFA_FOR_PRIVILEGED=true

# ------------------------------------------------------------
# SUBSCRIPTION / BILLING
# ------------------------------------------------------------
# When 'true', every authenticated user is treated as PREMIUM regardless of
# their stored accountTier. Use this during the introductory period before
# paid checkout is wired up. Set to 'false' once billing goes live.
BILLING_FREE_TIER_FOR_ALL=true

# ------------------------------------------------------------
# QR / TRACE SIGNING
# ------------------------------------------------------------
# Dedicated signing key used as HMAC fallback when RSA signing is unavailable.
# MUST be different from any JWT secret — a JWT leak must not allow QR forgery.
# Required in production (≥32 chars). Generate with: openssl rand -base64 48
QR_SIGNATURE_FALLBACK_SECRET=CHANGE_THIS_QR_HMAC_SECRET_DEDICATED_KEY

# ------------------------------------------------------------
# PAYMENT GATEWAY — Stripe (the ONLY gateway; slip rail is legacy, draining)
# ------------------------------------------------------------
# The current rail reads STRIPE_*. The old `PAYMENT_GATEWAY_PROVIDER=PROMPTPAY`
# line was misleading — the code has no PromptPay-provider gateway (removed 2026-08-16).
STRIPE_SECRET_KEY=sk_CHANGE_ME                    # platform Stripe secret key (sk_live in production)
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME             # Stripe webhook signing secret (from the dashboard endpoint)
STRIPE_PUBLISHABLE_KEY=pk_CHANGE_ME               # same account + mode as STRIPE_SECRET_KEY; handed to the browser for the PromptPay QR
STRIPE_CHECKOUT_ENABLED=false                     # flip "true" only after the slip drain-then-purge cutover
# Still required — inbound webhook HMAC verification (config/secrets.js):
PAYMENT_WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_HMAC_SECRET

# Proxy/IP trust model for secure client IP extraction
TRUST_PRIVATE_PROXY_RANGES=true
# TRUSTED_PROXY_IPS=127.0.0.1,172.20.0.2

# ------------------------------------------------------------
# PUBLIC URLS (IP / HTTP Mode for Testing)
# ------------------------------------------------------------
PUBLIC_API_URL=https://gacpth.com
PUBLIC_WEB_URL=https://gacpth.com
PUBLIC_HEALTH_URL=https://gacpth.com/health
PUBLIC_PROVIDER_URL=https://gacpth.com/provider
# App / frontend base + traceability base. REQUIRED in production — the backend
# refuses to boot without a trace URL: qrcode-service needs APP_PUBLIC_URL or
# TRACE_BASE_URL (or PUBLIC_TRACE_URL), and trace-service needs TRACE_BASE_URL
# specifically. QR codes resolve to `${TRACE_BASE_URL}/trace`.
APP_PUBLIC_URL=https://gacpth.com
FRONTEND_URL=https://gacpth.com
TRACE_BASE_URL=https://gacpth.com

# ------------------------------------------------------------
# GOV-TO-GOV INTEROPERABILITY (SEC-AUDIT-012)
# ------------------------------------------------------------
# Per-partner API keys for the /api/interoperability/v1 bulk-export endpoints
# (trust registry/revocations, trace events, e-certificate, signed envelope).
# JSON object {partnerId: secret}. Fail-closed: if unset, those endpoints
# reject every caller. Single-certificate verification remains public.
INTEROP_PARTNER_API_KEYS=

# PWA/Service Worker toggle
# Keep false until TLS certificate + domain are trusted in production.
NEXT_PUBLIC_PWA_ENABLED=false

# For production (replace with real domain)
# PUBLIC_API_URL=https://api.gacp-platform.com
# PUBLIC_WEB_URL=https://gacp-platform.com
# PUBLIC_HEALTH_URL=https://health.gacp-platform.com
# PUBLIC_PROVIDER_URL=https://provider.gacp-platform.com

# CORS allowlist for browser-origin requests to backend API (comma-separated)
# Keep this aligned with your public web origin(s).
CORS_ORIGIN=https://gacpth.com

# Email / SMS: none. The platform sends no email or SMS and has no
# forgot-password flow by either channel (operator 2026-09-16).

# ------------------------------------------------------------
# File Storage (S3-compatible / MinIO)
# ------------------------------------------------------------
# Set to 'minio' for MinIO, 'local' for Docker volume storage ('s3' is backward-compatible alias)
STORAGE_PROVIDER=minio

# MinIO admin credentials (used by docker-compose minio service)
MINIO_ROOT_USER=gacp-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD

# S3-compatible client config (used by backend storage-service)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=gacp-minio-admin
S3_SECRET_KEY=CHANGE_THIS_MINIO_PASSWORD
S3_REGION=us-east-1

# Public traceability URL base (for QR codes)
# PUBLIC_TRACE_URL=https://your-domain.com/trace

# ------------------------------------------------------------
# DATABASE ADMIN (pgAdmin)
# ------------------------------------------------------------
# Web UI for team to manage PostgreSQL — accessible at /pgadmin/
PGADMIN_EMAIL=admin@gacpth.com
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD

# ------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# ------------------------------------------------------------
# MAPS — DATA SOVEREIGNTY (required before maps render in production)
# ------------------------------------------------------------
# Farm coordinates are citizen PII under PDPA. A tile request encodes the area
# being viewed, so the tile host learns roughly where a Thai farm is, plus the
# citizen's IP, on every map view. There is NO built-in default and no foreign
# fallback: unset means the map surfaces render an honest "not configured"
# state showing coordinates as text.
#
# Point this at a source DTAM controls — an in-country provider, a self-hosted
# tile server, or a same-origin proxy through the backend. Whichever origin is
# used is added to the CSP img-src automatically (apps/web-app/src/middleware.ts
# derives it from this value), so no separate CSP edit is required.
#
# Must contain {z}, {x} and {y}.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# "Open this location in a map" links. Must contain {lat} and/or {lng}.
# Unset means those links do not render at all.
NEXT_PUBLIC_MAP_VIEWER_URL=
